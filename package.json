{
  "name": "nexus-agent",
  "version": "0.1.0",
  "description": "NEXUS AGENT - Desktop AI Coding Agent powered by Bun, Electron, and React",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Antigravity Pair",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "cli": "bun run ./bin/agent-cli",
    "server": "bun run ./src/server/index.ts",
    "test:bun": "bun test tests/",
    "test": "bun test tests/",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "deploy": "python scripts/deploy.py",
    "package": "electron-vite build && electron-builder --win dir",
    "package:portable": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@tiptap/core": "^3.31.0",
    "@tiptap/extensions": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "dompurify": "^3.4.15",
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.13",
    "officecrypto-tool": "^0.0.19",
    "opentype.js": "^2.0.0",
    "parse5": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "tailwind-merge": "^3.0.2",
    "utif2": "^4.1.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/diff": "^7.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "build": {
    "appId": "com.nexus.agent",
    "productName": "NEXUS-AGENT",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
